{
  "name": "zingo-fairness",
  "version": "0.1.0",
  "private": true,
  "description": "Is Zingo fair? A difficulty-vs-fairness analysis of the children's tile game, with an explorable map of every legal card set.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sample": "tsx reference/sample-search.ts",
    "exhaustive": "tsx scripts/build-data.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0"
  }
}